From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 29 Jul 2026 20:58:49 +0000
Subject: iommu/arm-smmu-v3: install bypass STEs for Sky1 PCIe boot
 SIDs

On CIX Sky1 (ACPI boot), firmware leaves PCIe endpoints (NVMe, NICs)
bus-mastering when the SMMU driver takes over. When the stream table is
reset, those in-flight masters hit abort STEs, causing C_BAD_STREAMID
storms and a boot wedge during PCI enumeration.

Detect the Sky1 PCIe SMMU by its physical base (0x0b010000) and
pre-install bypass STEs for the known root-port stream IDs before the
device reset, mirroring what arm_smmu_rmr_install_bypass_ste() does for
IORT RMR regions.

The Sky1 DTI ATS Master also emits translated TLPs even for endpoints
that never enabled ATS, so introduce ARM_SMMU_OPT_PCIE_ATS_OVERRIDE and
force EATS=translated in the STEs of PCIe masters when it is set.

Other platforms are unaffected: the quirk only engages on ACPI boot
when the SMMU MMIO base matches.

Validated on Radxa Orion O6 metal: NVMe and the RTL8127A NIC enumerate
cleanly with no C_BAD_STREAMID storm.
---
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c | 76 ++++++++++++++++++++-
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h |  1 +
 2 files changed, 75 insertions(+), 2 deletions(-)

diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
index 256fbe5a1..a33b434d6 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -1942,7 +1942,10 @@ void arm_smmu_make_cdtable_ste(struct arm_smmu_ste *target,
 			 STRTAB_STE_1_S1STALLD :
 			 0) |
 		FIELD_PREP(STRTAB_STE_1_EATS,
-			   ats_enabled ? STRTAB_STE_1_EATS_TRANS : 0));
+			   (ats_enabled ||
+			    ((smmu->options & ARM_SMMU_OPT_PCIE_ATS_OVERRIDE) &&
+			     dev_is_pci(master->dev))) ?
+				STRTAB_STE_1_EATS_TRANS : 0));
 
 	if ((smmu->features & ARM_SMMU_FEAT_ATTR_TYPES_OVR) &&
 	    s1dss == STRTAB_STE_1_S1DSS_BYPASS)
@@ -1994,7 +1997,10 @@ void arm_smmu_make_s2_domain_ste(struct arm_smmu_ste *target,
 
 	target->data[1] = cpu_to_le64(
 		FIELD_PREP(STRTAB_STE_1_EATS,
-			   ats_enabled ? STRTAB_STE_1_EATS_TRANS : 0));
+			   (ats_enabled ||
+			    ((smmu->options & ARM_SMMU_OPT_PCIE_ATS_OVERRIDE) &&
+			     dev_is_pci(master->dev))) ?
+				STRTAB_STE_1_EATS_TRANS : 0));
 
 	if (pgtbl_cfg->quirks & IO_PGTABLE_QUIRK_ARM_S2FWB)
 		target->data[1] |= cpu_to_le64(STRTAB_STE_1_S2FWB);
@@ -5394,6 +5400,71 @@ static void __iomem *arm_smmu_ioremap(struct device *dev, resource_size_t start,
 	return devm_ioremap_resource(dev, &res);
 }
 
+/*
+ * CIX Sky1 SoC PCIe SMMU quirks (ACPI boot).
+ *
+ * Firmware leaves PCIe endpoints (NVMe, NICs) bus-mastering; when the SMMU
+ * driver resets the stream table they hit abort STEs, causing C_BAD_STREAMID
+ * storms and a boot wedge during PCI enumeration. Detect the Sky1 PCIe SMMU
+ * by its physical base and pre-install bypass STEs for the known root-port
+ * SIDs; also force EATS for PCIe masters (the Sky1 DTI ATS Master emits
+ * translated TLPs even for non-ATS endpoints).
+ */
+#define CIX_SKY1_PCIE_SMMU_BASE	0x0b010000ULL
+
+static bool arm_smmu_is_cix_sky1_pcie(struct arm_smmu_device *smmu)
+{
+	struct resource *res;
+
+	if (smmu->dev->of_node)
+		return false;
+	res = platform_get_resource(to_platform_device(smmu->dev),
+				    IORESOURCE_MEM, 0);
+	return res && res->start == CIX_SKY1_PCIE_SMMU_BASE;
+}
+
+static const u32 cix_sky1_pcie_boot_sids[] = {
+	0x0000, 0x0100,		/* PCIe X1_0 */
+	0x3000, 0x3100,		/* PCIe X1_1 */
+	0x6000, 0x6100,		/* PCIe X2 */
+	0x9000, 0x9100,		/* PCIe X4 */
+	0xc000, 0xc100,		/* PCIe X8 */
+};
+
+static void arm_smmu_cix_sky1_install_bypass_ste(struct arm_smmu_device *smmu)
+{
+	unsigned int i, count = 0;
+
+	if (!arm_smmu_is_cix_sky1_pcie(smmu))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(cix_sky1_pcie_boot_sids); i++) {
+		u32 sid = cix_sky1_pcie_boot_sids[i];
+
+		if (arm_smmu_init_sid_strtab(smmu, sid)) {
+			dev_err(smmu->dev,
+				"Sky1 PCIe boot SID(0x%x) bypass failed\n",
+				sid);
+			continue;
+		}
+
+		arm_smmu_make_bypass_ste(smmu,
+			arm_smmu_get_step_for_sid(smmu, sid));
+		count++;
+	}
+
+	/*
+	 * The Sky1 PCIe DTI ATS Master emits translated TLPs even for
+	 * non-ATS endpoints. Keep EATS enabled in the translated STEs
+	 * installed for the normal DMA domains.
+	 */
+	smmu->options |= ARM_SMMU_OPT_PCIE_ATS_OVERRIDE;
+
+	dev_info(smmu->dev,
+		 "CIX Sky1 PCIe SMMU: %u bypass STEs installed, ATS override enabled\n",
+		 count);
+}
+
 static void arm_smmu_rmr_install_bypass_ste(struct arm_smmu_device *smmu)
 {
 	struct list_head rmr_list;
@@ -5578,6 +5649,7 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 
 	/* Check for RMRs and install bypass STEs if any */
 	arm_smmu_rmr_install_bypass_ste(smmu);
+	arm_smmu_cix_sky1_install_bypass_ste(smmu);
 
 	/* Reset the device */
 	ret = arm_smmu_device_reset(smmu, false);
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
index ef42df475..c6b40e9a0 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
@@ -861,6 +861,7 @@ struct arm_smmu_device {
 #define ARM_SMMU_OPT_MSIPOLL		(1 << 2)
 #define ARM_SMMU_OPT_CMDQ_FORCE_SYNC	(1 << 3)
 #define ARM_SMMU_OPT_TEGRA241_CMDQV	(1 << 4)
+#define ARM_SMMU_OPT_PCIE_ATS_OVERRIDE	(1 << 5)
 	u32				options;
 
 	struct arm_smmu_cmdq		cmdq;
-- 
